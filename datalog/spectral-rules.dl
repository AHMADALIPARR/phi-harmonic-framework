% Datalog Spectral Grep Rules — source-preserved
observed_peak(46.98, 0.95).
observed_peak(50.98, 0.42).
observed_peak(39.98, 0.38).
observed_peak(75.98, 0.01).
fib_freq(4).
fib_freq(7).
fib_freq(11).
fib_freq(18).
fib_freq(29).
fib_freq(47).
candidate_carrier(Fc) :-
    observed_peak(Fc, Amp),
    Fc >= 46.8, Fc <= 47.2,
    Amp > 0.8.
sideband_triplet(Fc, Fj, ObservedFreq) :-
    candidate_carrier(Fc),
    fib_freq(Fj),
    (ObservedFreq is Fc + Fj ; ObservedFreq is Fc - Fj),
    observed_peak(ObservedFreq, SideAmp),
    SideAmp > 0.2.
phi_harmonic_system(Fc, ValidCount) :-
    candidate_carrier(Fc),
    findall(Fj, sideband_triplet(Fc, Fj, _), Sidebands),
    length(Sidebands, ValidCount),
    ValidCount >= 3.
